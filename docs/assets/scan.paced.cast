[1.355, "o", "     Hardcoded http://localhost:3000 in src/main.tsx.\r\n"]
[1.41, "o", "\u001b[2m     Use import.meta.env.VITE_API_BASE_URL. VITE_API_BASE_URL will be added to .env.example.\u001b[22m\r\n"]
[1.465, "o", "\r\n"]
