[2.785, "o", "     STRIPE_SECRET_KEY is referenced in server/stripe-webhook.ts but missing from .env.example and .env.\r\n"]
[2.84, "o", "\u001b[2m     An .env.example entry and .vibe-rescue/check-env.mjs will be generated. Fill in the real value locally.\u001b[22m\r\n"]
