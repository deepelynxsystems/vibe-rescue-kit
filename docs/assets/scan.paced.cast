[2.125, "o", "\u001b[1msupabase-rls\u001b[22m  \u001b[33mfound\u001b[39m\r\n"]
[2.18, "o", "  \u001b[31m✗\u001b[39m  \u001b[2msupabase/migrations/20240101000000_init.sql\u001b[22m\r\n"]
[2.235, "o", "     Table public.notes is created without ENABLE ROW LEVEL SECURITY.\r\n"]
[2.29, "o", "\u001b[2m     A new migration will enable RLS and add a deny-all policy for anon and authenticated. No database is contacted.\u001b[22m\r\n"]
[2.345, "o", "\r\n"]
[2.4, "o", "\u001b[1mwebhook-signature\u001b[22m  \u001b[33mfound\u001b[39m\r\n"]
[2.455, "o", "  \u001b[31m✗\u001b[39m  \u001b[2mserver/stripe-webhook.ts\u001b[22m\r\n"]
[2.51, "o", "     server/stripe-webhook.ts handles a Stripe webhook without constructEvent.\r\n"]
[2.565, "o", "\u001b[2m     A signature check will be inserted. Set STRIPE_WEBHOOK_SECRET and send Stripe the raw body.\u001b[22m\r\n"]
[2.62, "o", "\r\n"]
