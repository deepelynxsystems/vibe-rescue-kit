[0.365, "o", "\u001b[1mleaked-secrets\u001b[22m  \u001b[33mfound\u001b[39m\r\n"]
[0.42, "o", "  \u001b[31m✗\u001b[39m  \u001b[2msrc/main.tsx:5\u001b[22m\r\n"]
[0.475, "o", "     Hardcoded service role jwt in client file src/main.tsx.\r\n"]
[0.53, "o", "\u001b[2m     Move it to SUPABASE_SERVICE_ROLE_KEY in a gitignored .env file and rotate it.\u001b[22m\r\n"]
[0.585, "o", "  \u001b[31m✗\u001b[39m  \u001b[2m.env\u001b[22m\r\n"]
[0.64, "o", "     .env is not gitignored and can be committed with secrets.\r\n"]
[0.695, "o", "\u001b[2m     Add it to .gitignore. If git already tracks it, run git rm --cached .env and rotate the keys.\u001b[22m\r\n"]
[0.75, "o", "\r\n"]
[0.805, "o", "\u001b[1mimport-paths\u001b[22m  \u001b[33mfound\u001b[39m\r\n"]
[0.86, "o", "  \u001b[31m✗\u001b[39m  \u001b[2msrc/main.tsx\u001b[22m\r\n"]
[0.915, "o", "     src/main.tsx imports date-fns, which is not in package.json.\r\n"]
[0.97, "o", "\u001b[2m     date-fns will be added with version *. Run npm install afterwards.\u001b[22m\r\n"]
[1.025, "o", "  \u001b[31m✗\u001b[39m  \u001b[2msrc/main.tsx\u001b[22m\r\n"]
[1.08, "o", "     src/main.tsx imports ./components/button, but the path on disk is ./components/Button.\r\n"]
[1.135, "o", "\u001b[2m     The specifier will be rewritten to the casing that exists on disk.\u001b[22m\r\n"]
[1.19, "o", "\r\n"]
[1.245, "o", "\u001b[1mhardcoded-localhost\u001b[22m  \u001b[33mfound\u001b[39m\r\n"]
