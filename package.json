{
  "name": "vibe-rescue-kit",
  "version": "0.1.0",
  "description": "Automatic, reversible fixes for the failures AI vibe-coding tools leave behind.",
  "type": "module",
  "bin": {
    "vibe-rescue": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "rules",
    "templates",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "deepelynx (https://deepelynx.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepelynxsystems/vibe-rescue-kit.git"
  },
  "homepage": "https://github.com/deepelynxsystems/vibe-rescue-kit#readme",
  "bugs": {
    "url": "https://github.com/deepelynxsystems/vibe-rescue-kit/issues"
  },
  "keywords": [
    "vibe-coding",
    "lovable",
    "cursor",
    "bolt",
    "v0",
    "replit",
    "supabase",
    "codemod",
    "security",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "bash scripts/demo.sh",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "diff": "^9.0.0",
    "ignore": "^7.0.5",
    "jiti": "^2.6.1",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.19.1",
    "@types/picomatch": "^4.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
